    "verify:gcp": "node scripts/verify-gcp-services.mjs",
    "prepare": "husky"
  },
  "overrides": {
    "@vercel/node": {
      "undici": "^6.29.0",
      "esbuild": "^0.28.1"
    },
    "@vercel/static-config": {
      "ajv": "^8.20.0"
    },
    "tsx": "^4.23.15"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1121.0",
    "@neondatabase/serverless": "^1.1.0",
    "@react-pdf/renderer": "^4.9.0",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.5",
    "@vercel/oidc-aws-credentials-provider": "^3.3.5",
    "@vercel/speed-insights": "^2.0.0",
