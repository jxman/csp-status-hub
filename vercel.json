{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "csp-status-hub.vercel.app" }],
      "destination": "https://cloudstatus.synepho.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/admin/subscribers", "destination": "/api/admin/subscribers/[id]" },
    { "source": "/api/admin/subscribers/:id", "destination": "/api/admin/subscribers/[id]" },
    { "source": "/api/auth/:action", "destination": "/api/auth/[action]" },
    { "source": "/api/subscribe", "destination": "/api/subscribe/[action]" },
    { "source": "/api/subscribe/:action", "destination": "/api/subscribe/[action]" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(admin|manage)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "functions": {
    "api/analysis/run.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/pdfkit/js/standard-fonts/**"
    },
    "api/admin/analysis-admin.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/pdfkit/js/standard-fonts/**"
    },
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    { "path": "/api/cron/check-status", "schedule": "0 0 * * *" },
    { "path": "/api/cron/cleanup", "schedule": "0 3 * * *" }
  ]
}
