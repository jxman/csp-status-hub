# Copy to .env.local, or pull the real values with: vercel env pull .env.local
# The dashboard itself needs none of these — they power alerts, AI briefs, and admin.

# Neon Postgres (Vercel Marketplace)
DATABASE_URL=

# Upstash Redis (Vercel Marketplace)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Email (Resend)
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=

# Base URL used for links in emails, e.g. https://cloudstatus.synepho.com
APP_BASE_URL=

# Shared secret for EventBridge / Vercel cron and /api/analysis/run
CRON_SECRET=

# Admin auth (Sign in with Vercel)
VERCEL_OAUTH_CLIENT_ID=
VERCEL_OAUTH_CLIENT_SECRET=
SESSION_SECRET=
ADMIN_EMAIL=

# AI briefs (AWS Bedrock via Vercel OIDC) — role ARN is printed by scripts/setup-bedrock-oidc.sh
AWS_ROLE_ARN=
AWS_REGION=us-east-1
# Optional: cross-region inference profile ID (production uses us.anthropic.claude-sonnet-4-6)
BEDROCK_MODEL_ID=
# Optional: minutes between briefs for the same incident (default 30)
ANALYSIS_DEBOUNCE_MINUTES=

# Vercel Blob (PDF briefs) — auto-injected once a Blob store is connected
BLOB_READ_WRITE_TOKEN=
