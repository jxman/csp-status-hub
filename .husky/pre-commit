# Block commits containing unresolved merge conflict markers
conflict_files=$(git diff --cached --name-only --diff-filter=ACM -z | xargs -0 -I{} sh -c 'grep -lE "^(<<<<<<<|=======|>>>>>>>)( |$)" "{}" 2>/dev/null' || true)
if [ -n "$conflict_files" ]; then
  echo "Merge conflict markers found in staged files:"
  echo "$conflict_files"
  exit 1
fi

# Scan staged changes for secrets (GitGuardian)
if ! command -v ggshield >/dev/null 2>&1; then
  echo "ggshield not found. Install with: brew install ggshield (then: ggshield auth login)"
  exit 1
fi
ggshield secret scan pre-commit

npx lint-staged
